# ============================================================
# Zyphers Polar EMS — Environment Variables
# Copy this file to backend/.env and fill in your values.
# NEVER commit .env to git!
# ============================================================

# Groq LLM API key (get one free at https://console.groq.com)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# PostgreSQL database URL
# Local:  postgresql://postgres:password@localhost:5432/polar_station_db
# Render: get this from your Render PostgreSQL dashboard
# Supabase: get from Project Settings > Database > Connection String
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secret key used by ESP32 hardware nodes to authenticate POST requests
# Must match the API_KEY constant in esp32_sensor.ino
HARDWARE_API_KEY=zyphers-esp32-secret-2026

# JWT signing secret — use a long random string in production
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-secret-string
